# Copy this file to `.env` and change the values. NEVER commit `.env`.
# These are LOCAL DEVELOPMENT values only. Production secrets are set on the
# host as environment variables, never in git.

# --- PostgreSQL (local Docker container) ---
POSTGRES_DB=geyc
POSTGRES_USER=geyc_app
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_PORT=5432

# --- Redis (local Docker container) ---
REDIS_PASSWORD=change-me-dev-only
REDIS_PORT=6379

# --- Ports exposed on your computer ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Added in later tasks (T-002 onwards): SECRET_KEY, ALLOWED_HOSTS,
# CORS_ALLOWED_ORIGINS, CSRF_TRUSTED_ORIGINS, email settings.
